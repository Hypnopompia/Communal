# Copy this file to ".env" and fill in your own values. ".env" is never committed.

# Signing and notarizing the Mac app (used by `pnpm release`, never bundled into the app).
# The "Developer ID Application" certificate itself lives in your keychain.
# App Store Connect API key: App Store Connect > Users and Access > Integrations > Team Keys.
# APPLE_API_KEY is the path to the downloaded AuthKey_XXXXXXXXXX.p8 file (keep it outside the repo).
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
