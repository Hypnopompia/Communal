{
  "name": "@communal/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Communal desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "electron .",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@communal/core": "workspace:*",
    "@communal/crypto": "workspace:*",
    "@communal/mcp": "workspace:*",
    "@communal/protocol": "workspace:*",
    "electron-updater": "^6.8.9",
    "pino": "^10.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.7"
  },
  "productName": "Communal",
  "author": "Communal contributors",
  "homepage": "https://hypnopompia.github.io/Communal/"
