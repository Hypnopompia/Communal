# Settings for the Communal service (systemd EnvironmentFile). Uncomment to change.
# UDP port for peers (0: pick one). Forward it on your router for the best reachability.
#COMMUNAL_PEER_PORT=41641
# Extra address:port others can reach this machine at (port forwards, a public IP).
#COMMUNAL_ADVERTISE_ADDR=203.0.113.7:41641
# Don't ask the router to open the port (UPnP / NAT-PMP).
#COMMUNAL_UPNP=false
# Upload limits.
#COMMUNAL_UPLOAD_KBPS=5000
#COMMUNAL_MAX_UPLOADS=4
#COMMUNAL_LAN_ONLY=false
# Where downloads and subscriptions land (must be writable: add it to ReadWritePaths too).
#COMMUNAL_DOWNLOADS=/var/lib/communal/downloads
