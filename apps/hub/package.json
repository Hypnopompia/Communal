{
  "name": "@communal/hub",
  "version": "0.1.5",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "communal-hub": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "COMMUNAL_BUILD=dev COMMUNAL_DEV_TLS=self-signed tsx --conditions=@communal/source src/main.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@communal/crypto": "workspace:*",
    "@communal/protocol": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "pino": "^10.4.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2"
  },
  "exports": {
    ".": {
      "@communal/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@communal/source": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  }
}
