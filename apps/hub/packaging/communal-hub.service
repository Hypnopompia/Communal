# Communal hub (HANDOFF §10). Installed by packaging/install.sh.
# Admin commands work on the database alongside the running hub:
#   sudo -u communal-hub env COMMUNAL_HUB_DATA=/var/lib/communal-hub /usr/local/bin/communal-hub users
[Unit]
Description=Communal hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=communal-hub
Group=communal-hub
Environment=COMMUNAL_HUB_DATA=/var/lib/communal-hub
Environment=NODE_ENV=production
# TLS certificate, port and join mode live here (see communal-hub.env.example).
EnvironmentFile=/etc/communal-hub/communal-hub.env
ExecStart=/opt/communal-hub/bin/communal-hub serve
Restart=on-failure
RestartSec=5
StateDirectory=communal-hub
StateDirectoryMode=0700
UMask=0077
# Lets the hub listen on 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/communal-hub
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
