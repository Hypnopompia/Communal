# Communal hub settings (systemd EnvironmentFile: /etc/communal-hub/communal-hub.env).

# Port for clients (wss://<host>/v1). 443 lets the hub address be just the host name.
COMMUNAL_HUB_PORT=443
# NAT probe ports (UDP): forward both from the router as well (HANDOFF §8).
COMMUNAL_PROBE_PORT_A=3478
COMMUNAL_PROBE_PORT_B=3479

# TLS: the hub terminates TLS itself (it needs each client's real address, so no proxy).
# With certbot, these are the Let's Encrypt files, readable by the communal-hub user.
COMMUNAL_TLS_CERT=/etc/communal-hub/tls/fullchain.pem
COMMUNAL_TLS_KEY=/etc/communal-hub/tls/privkey.pem

# New accounts: "approval" (an admin approves each one with `communal-hub approve`) or
# "open". Only read on the first start; afterwards use `communal-hub set join_mode`.
COMMUNAL_JOIN_MODE=approval
